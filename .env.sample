# Validated at startup by src/config.js; the server refuses to start if a required value is missing.

# development | production | test (production enables Secure / SameSite=None cookies)
NODE_ENV=development
# default 5000
PORT=5000
# comma-separated browser origins allowed by CORS
CLIENT_URLS=http://localhost:3000

# required; the database name is appended by the app
MONGODB_URL=

# required
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# defaults: 15m, 7d
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
# SameSite for auth cookies: lax (default, use with the frontend's /api proxy) | strict | none (cross-site API calls)
COOKIE_SAME_SITE=lax

# required
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Proxy hops in front of the API (unset = none, 1 = one load balancer/reverse proxy)
TRUST_PROXY=

# Upload size limits in MB (optional, defaults: 10 for images, 500 for videos)
MAX_IMAGE_SIZE_MB=
MAX_VIDEO_SIZE_MB=

# fatal | error | warn | info | debug | trace | silent (default: info, silent in tests)
LOG_LEVEL=
